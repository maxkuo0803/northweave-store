# 複製本檔為 .env.local 後填入（.env.local 不會進版控）

# MySQL 連線字串：mysql://使用者:密碼@主機:3306/資料庫
DATABASE_URL="mysql://shop:CHANGE_ME@localhost:3306/clothing_shop"

# Better Auth 加密用的密鑰，用這個指令產生：openssl rand -base64 32
AUTH_SECRET=""
# 網站網址（上線後改成正式網域）
BETTER_AUTH_URL="http://localhost:3000"

# ── AI 客服 ──
# 到 https://console.anthropic.com 取得 API Key。沒填的話 AI 客服會用「模擬模式」（規則式，免費，能力有限）
ANTHROPIC_API_KEY=
# 客服用的模型：預設 claude-haiku-5-5（最便宜，每則回覆約 US$0.001–0.003）
AGENT_MODEL=claude-haiku-5-5
# 全站每天最多幾次 AI 回覆（費用保險絲）
AGENT_DAILY_LIMIT=2000

# ── AI 知識庫（RAG）語意搜尋：https://dash.voyageai.com 申請 ──
# 沒填的話知識庫只用關鍵字搜尋（一樣能用，但「寄送費」找不到「運費」這種換句話說）
VOYAGE_API_KEY=

# ── LINE 官方帳號（LINE Developers → Messaging API channel）──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── Gmail 客服信箱（Google Cloud OAuth，步驟見 README「串接 Gmail」）──
GMAIL_ADDRESS=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# 定時收信 /api/cron/gmail 用的密碼：openssl rand -hex 24
CRON_SECRET=

# 公開的展示店員帳號能不能回覆 LINE / Email 顧客（預設不行，只有 admin 可以）
ALLOW_STAFF_EXTERNAL_REPLY=false
